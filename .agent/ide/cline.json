{
  "name": "DOMYH Awesome Code",
  "version": "v6.7.21",
  "ide": "Cline",
  "value": "cline",
  "activation": {
    "triggers": [
      "/ap",
      "/code",
      "/debug",
      "/deploy",
      "/dev",
      "/doc",
      "/fix",
      "/git",
      "/hsa",
      "/init",
      "/plan",
      "/refactor",
      "/review",
      "/security",
      "/status",
      "/test"
    ],
    "auto_context": true
  },
  "skills": {
    "loading": "progressive",
    "max_active": 3
  },
  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v2.0.22 Context Management",
      "command": "npx",
      "args": [
        "-y",
        "@nockdev/hsa@latest"
      ],
      "auto_start": true,
      "env": {
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  },
  "config_files": {
    "rules": ".clinerules",
    "mcp": "globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json"
  }
}