{
  "name": "DOMYH Agent Kit",
  "version": "v6.7.21",
  "ide": "OpenCode",
  "value": "opencode",
  "activation": {
    "triggers": [
      "/ap",
      "/code",
      "/debug",
      "/deploy",
      "/dev",
      "/doc",
      "/fix",
      "/git",
      "/hsa",
      "/init",
      "/plan",
      "/refactor",
      "/review",
      "/security",
      "/status",
      "/test"
    ],
    "auto_context": true
  },
  "skills": {
    "loading": "progressive",
    "max_active": 3
  },
  "mcp_servers": {
    "domyh-hsa": {
      "description": "HSA v2.0.22 Context Management",
      "command": "npx",
      "args": [
        "-y",
        "@nockdev/hsa@latest"
      ],
      "auto_start": true,
      "env": {
        "HSA_DASHBOARD": "true",
        "HSA_MAX_TOKENS": "8000"
      }
    }
  },
  "config_files": {
    "config": "opencode.json",
    "mcp_key": "mcp",
    "mcp_note": "OpenCode uses 'mcp' key in opencode.json. Supports local + remote + OAuth, per-agent MCP"
  }
}